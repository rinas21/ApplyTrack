# ApplyTrack local development environment
# Copy to .env and adjust values. Never commit real secrets.

# Postgres (shared instance; separate logical DBs for app and Keycloak)
POSTGRES_USER=applytrack
POSTGRES_PASSWORD=applytrack
POSTGRES_DB=applytrack
KEYCLOAK_DB=keycloak

# Rust API
DATABASE_URL=postgres://applytrack:applytrack@postgres:5432/applytrack
BIND_ADDR=0.0.0.0:8080
CORS_ORIGIN=http://localhost:4200
KEYCLOAK_ISSUER=http://localhost:8180/realms/applytrack
# Optional: for container-internal token validation when issuer differs from public URL
# KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/applytrack/protocol/openid-connect/certs
# KEYCLOAK_AUDIENCE=applytrack-web
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-secret-at-least-32-bytes
WORKER_POLL_SECONDS=120

# Local dev only: bypass JWT validation using X-Dev-Sub header. NEVER enable in production.
DEV_AUTH_BYPASS=false

# Keycloak admin (local dev)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Google Gmail integration (required for real Gmail sync)
# Create OAuth 2.0 credentials in Google Cloud Console (Web application).
# Authorized redirect URI must match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/settings/email/callback

# Frontend
API_BASE_URL=http://localhost:8080/api/v1
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=applytrack
KEYCLOAK_CLIENT_ID=applytrack-web
